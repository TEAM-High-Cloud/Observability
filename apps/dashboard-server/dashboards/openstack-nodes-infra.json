  "description": "Host-level resource observability for OpenStack hosts pc1/pc2, fed by OTel hostmetrics receiver. Metric names and resource attribute keys retain dot notation as VictoriaMetrics ingests OTLP without the Prometheus naming translation.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage (%)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "editorMode": "code",
          "expr": "label_replace(100 * (1 - sum by (\"k8s.cluster.name\") (rate({__name__=\"system.cpu.time\", state=\"idle\", \"k8s.cluster.name\"=~\"$cluster\"}[5m])) / sum by (\"k8s.cluster.name\") (rate({__name__=\"system.cpu.time\", \"k8s.cluster.name\"=~\"$cluster\"}[5m]))), \"cluster\", \"$1\", \"k8s.cluster.name\", \"(.+)\")",
          "legendFormat": "{{cluster}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Load average (1m / 5m / 15m)",
