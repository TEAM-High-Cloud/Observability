          "expr": "label_replace(avg by (\"k8s.cluster.name\") ({__name__=\"system.cpu.load_average.1m\", \"k8s.cluster.name\"=~\"$cluster\"}), \"cluster\", \"$1\", \"k8s.cluster.name\", \"(.+)\")",
          "legendFormat": "{{cluster}} - 1m",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "editorMode": "code",
          "expr": "label_replace(avg by (\"k8s.cluster.name\") ({__name__=\"system.cpu.load_average.5m\", \"k8s.cluster.name\"=~\"$cluster\"}), \"cluster\", \"$1\", \"k8s.cluster.name\", \"(.+)\")",
          "legendFormat": "{{cluster}} - 5m",
          "range": true,
          "refId": "B"
